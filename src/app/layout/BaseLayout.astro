---
// Alta Pinta — layout base
import '../styles/global.css';
const title = 'Alta Pinta — Pizzería';
const description = 'Menú de Alta Pinta: pizzas artesanales, bebidas y postres. Pide en línea y recibe tus órdenes directo en tu mesa.';
---
<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" sizes="64x64" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
